# Current testing provider. Keep API keys only in backend/.env; never expose
# them through Vite variables or commit them to source control.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TUTOR_MODEL=openai/gpt-oss-120b
GROQ_EVALUATOR_MODEL=openai/gpt-oss-20b

# LOCAL LLM FALLBACK — retained for the future first-run provider selector.
# Set LLM_PROVIDER=ollama to use these values explicitly.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:latest
OLLAMA_EVALUATOR_MODEL=phi3:latest

PORT=8787
